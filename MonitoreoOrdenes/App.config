<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<connectionStrings>
		<add name="MonitoreoDB"
			 connectionString="Server=DSKTPA;Database=MonitoreoOrdenesCompra;Integrated Security=True;TrustServerCertificate=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<appSettings>
		<add key="AppVersion"  value="1.0.0" />
		<add key="Empresa"     value="PluriOne S.A. de C.V." />
		<add key="NombreApp"   value="Monitoreo de Órdenes de Compra" />
	</appSettings>

</configuration>
