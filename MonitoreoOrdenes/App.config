<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>

	<!-- La conexion a la base de datos NO va aqui: cada equipo tiene su propio
	     conexion.config (Git lo ignora). Se crea solo, a partir de
	     conexion.config.example, la primera vez que se compila. -->
	<connectionStrings configSource="conexion.config" />

	<!-- entorno.config (opcional, tambien ignorado por Git) puede cambiar "Entorno"
	     a Produccion. Sin ese archivo se usa Desarrollo. -->
	<appSettings file="entorno.config">
		<add key="AppVersion"  value="1.0.0" />
		<add key="Empresa"     value="PluriOne S.A. de C.V." />
		<add key="NombreApp"   value="Monitoreo de Órdenes de Compra" />
		<add key="Entorno"     value="Desarrollo" />
	</appSettings>

</configuration>
