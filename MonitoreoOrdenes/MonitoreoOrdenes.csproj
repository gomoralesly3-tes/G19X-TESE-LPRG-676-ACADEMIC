  <!-- Primera compilacion en un equipo nuevo: crea conexion.config y entorno.config
       a partir de los modelos. Esos archivos son propios de cada equipo y Git los ignora. -->
  <Target Name="CrearConfiguracionLocal" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="conexion.config.example" DestinationFiles="conexion.config" Condition="!Exists('conexion.config')" />
    <Copy SourceFiles="entorno.config.example" DestinationFiles="entorno.config" Condition="!Exists('entorno.config')" />
  </Target>
